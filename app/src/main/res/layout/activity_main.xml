<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:background="#212121" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_above="@+id/navBottom" android:padding="12dp">
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><TextView android:text="XAMusicel" android:textColor="#fff" android:textSize="22sp" android:textStyle="bold" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/><ImageView android:src="@android:drawable/ic_search_category_default" android:layout_width="24dp" android:layout_height="24dp"/><ImageView android:src="@android:drawable/ic_menu_more" android:layout_marginLeft="16dp" android:layout_width="24dp" android:layout_height="24dp"/></LinearLayout>
        <LinearLayout android:background="#182533" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="12dp" android:gravity="center_vertical" android:padding="10dp"><ImageView android:src="@android:drawable/ic_search_category_default" android:layout_width="18dp" android:layout_height="18dp"/><EditText android:id="@+id/etSearch" android:background="@null" android:hint="Cari lagu, artis, playlist..." android:textColor="#fff" android:textColorHint="#6d7f8f" android:layout_marginLeft="10dp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/></LinearLayout>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="12dp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/bottomPlayer" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_above="@+id/navBottom" android:background="#0e1621" android:visibility="gone" android:padding="10dp">
        <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content"><ImageView android:id="@+id/imgArt" android:layout_width="48dp" android:layout_height="48dp"/><LinearLayout android:orientation="vertical" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="10dp"><TextView android:id="@+id/txtTitle" android:textColor="#fff" android:textSize="14sp" android:textStyle="bold" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:id="@+id/txtArtist" android:textColor="#a1a1aa" android:textSize="11sp" android:singleLine="true" android:layout_width="match_parent" android:layout_height="wrap_content"/></LinearLayout><ImageView android:id="@+id/btnPrev" android:src="@android:drawable/ic_media_previous" android:background="#2b5278" android:padding="8dp" android:layout_width="38dp" android:layout_height="38dp"/><ImageView android:id="@+id/btnPlay" android:src="@android:drawable/ic_media_pause" android:background="#5288c1" android:padding="8dp" android:layout_marginLeft="8dp" android:layout_width="44dp" android:layout_height="44dp"/><ImageView android:id="@+id/btnNext" android:src="@android:drawable/ic_media_next" android:background="#2b5278" android:padding="8dp" android:layout_marginLeft="8dp" android:layout_width="38dp" android:layout_height="38dp"/></LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/navBottom" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="56dp" android:layout_alignParentBottom="true" android:background="#0e1621" android:gravity="center"><TextView android:text="Obrolan" android:textColor="#5288c1" android:drawableTop="@android:drawable/sym_action_chat" android:gravity="center" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/><TextView android:text="Kontak" android:textColor="#6d7f8f" android:drawableTop="@android:drawable/ic_menu_myplaces" android:gravity="center" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/><TextView android:text="Pengaturan" android:textColor="#6d7f8f" android:drawableTop="@android:drawable/ic_menu_preferences" android:gravity="center" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/><TextView android:text="Profil" android:textColor="#6d7f8f" android:drawableTop="@android:drawable/ic_menu_my_calendar" android:gravity="center" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/></LinearLayout>
</RelativeLayout>